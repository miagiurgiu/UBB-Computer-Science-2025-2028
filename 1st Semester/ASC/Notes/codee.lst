    12                                  
    13                                  segment data use32 class=data
    14 00000000 696E7075742E747874-         input_name db "input.txt",0 ; inside it we have 10 3 -2 7 -5 4 -8 20 0 but 0 is not part of the array
    14 00000009 00                 
    15 0000000A 7200                        mode_r db "r",0
    16                                  
    17 0000000C 00000000                    fin dd 0 ; stores the file handle returned by fopen
    18 00000010 00000000                    fout dd 0
    19                                  
    20 00000014 00000000<rept>              x times 100 dd 0 ; here will be stored the numbers from input.txt 10 3 -2 7 -5 4 -8 20
    21 000001A4 00000000<rept>              y times 100 dd 0 ; here will be stored each partial sum 10, 13, 11, 18, 13, 17, 9, 29
    22                                  
    23 00000334 256400                      fmt_int db "%d",0 ; read one integer
    24 00000337 256420256400                fmt_pair db "%d %d",0 ; read two integers
    25 0000033D 25640A00                    fmt_out db "%d",10,0 ; print integer + newline
    26                                  
    27                                      ; variables for user-entered pairs:
    28 00000341 00000000                    a dd 0
    29 00000345 00000000                    b dd 0
    30                                      
    31                                      ; temporary pointer used to store computed addresses for fscanf
    32 00000349 00000000                    pointer dd 0 
    33                                      
    34 0000034D 00<rept>                    output_name times 100 db 0
    35 000003B1 7700                        mode_w db "w", 0
    36 000003B3 257300                      fmt_string db "%s", 0
    37                                  
    38                                  segment code use32 class=code
    39                                      start:
    40                                  
    41                                      ; open input file
    42 00000000 68[0A000000]                    push mode_r
    43 00000005 68[00000000]                    push input_name
    44 0000000A FF15[00000000]                  call [fopen]
    45 00000010 83C408                          add esp,4*2
    46 00000013 A3[0C000000]                    mov [fin],eax ; store returned file pointer from eax into variable fin
    47                                  
    48                                      ; read numbers from file into x[] until 0
    49 00000018 BE00000000                      mov esi,0  ; esi is the index that goes through x
    50                                          
    51                                      read_nums:
    52                                          ; compute address of x[esi]
    53 0000001D BB[14000000]                    mov ebx, x ; x is the base address
    54 00000022 89F0                            mov eax, esi
    55 00000024 6BC004                          imul eax, 4 ; each element is 4 bytes
    56 00000027 01C3                            add ebx, eax
    57 00000029 891D[49030000]                  mov [pointer], ebx
    58                                          
    59                                          ; read one integer from file into x[esi]
    60 0000002F FF35[49030000]                  push dword [pointer]; address of x[esi]
    61 00000035 68[34030000]                    push fmt_int
    62 0000003A FF35[0C000000]                  push dword [fin]
    63 00000040 FF15[00000000]                  call [fscanf]
    64 00000046 83C40C                          add esp,4*3
    65                                          
    66                                          ; check if the number is 0 -> stop, end of list
    67 00000049 8B04B5[14000000]                mov eax,[x+esi*4] ; the address of x[esi]
    68 00000050 83F800                          cmp eax,0
    69 00000053 7403                            je make_prefix
    70 00000055 46                              inc esi
    71 00000056 EBC5                            jmp read_nums
    72                                  
    73                                      ; build prefix sums in y[]
    74                                      make_prefix:
    75 00000058 B900000000                      mov ecx,0
    76 0000005D A1[14000000]                    mov eax,[x]
    77 00000062 A3[A4010000]                    mov [y],eax ; y[0]=x[0]
    78                                      
    79                                      prefix_loop:
    80 00000067 41                              inc ecx
    81 00000068 39F1                            cmp ecx,esi
    82 0000006A 7D17                            jge done_prefix ; stop when we encounter the last index
    83                                          
    84                                          ; compute y[ecx] = y[ecx-1] + x[ecx]
    85 0000006C 8B048D[A0010000]                mov eax,[y+(ecx-1)*4]
    86 00000073 03048D[14000000]                add eax,[x+ecx*4]
    87 0000007A 89048D[A4010000]                mov [y+ecx*4],eax
    88 00000081 EBE4                            jmp prefix_loop
    89                                          ; now we have y = 10 13 11 18 13 17 9 29
    90                                  
    91                                      done_prefix:
    92                                  
    93                                      ; read output filename
    94 00000083 68[4D030000]                    push output_name
    95 00000088 68[B3030000]                    push fmt_string
    96 0000008D FF15[00000000]                  call [scanf]
    97 00000093 83C408                          add esp, 8
    98                                      
    99                                      ;open output file
   100 00000096 68[B1030000]                    push mode_w
   101 0000009B 68[4D030000]                    push output_name
   102 000000A0 FF15[00000000]                  call [fopen]
   103 000000A6 83C408                          add esp, 8
   104 000000A9 A3[10000000]                    mov [fout], eax
   105                                      
   106                                      ; read pairs from keyboard
   107                                      read_pairs:
   108 000000AE 68[45030000]                    push b
   109 000000B3 68[41030000]                    push a
   110 000000B8 68[37030000]                    push fmt_pair
   111 000000BD FF15[00000000]                  call [scanf]
   112 000000C3 83C40C                          add esp,4*3
   113                                              
   114                                          ; check if we need to exit 
   115 000000C6 A1[41030000]                    mov eax,[a]
   116 000000CB 8B15[45030000]                  mov edx,[b]
   117                                  
   118 000000D1 83F8FF                          cmp eax,-1
   119 000000D4 7505                            jne check_int
   120 000000D6 83FAFF                          cmp edx,-1
   121 000000D9 7440                            je end_all
   122                                  
   123                                      check_int:
   124                                          ; validate interval 
   125 000000DB 83F800                          cmp eax,0
   126 000000DE 7CCE                            jl read_pairs ; a<0 => invalid => next pair
   127 000000E0 39C2                            cmp edx,eax
   128 000000E2 7CCA                            jl read_pairs ; b<a => invalid => next pair
   129 000000E4 39F2                            cmp edx,esi
   130 000000E6 7DC6                            jge read_pairs ; b>=the nr of elements => invalid => next pair
   131                                      
   132                                          ; compute sum using prefix sums
   133                                          ; if a=0
   134 000000E8 83F800                          cmp eax,0 
   135 000000EB 7509                            jne normal_sum
   136 000000ED 8B0C95[A4010000]                mov ecx,[y+edx*4]
   137 000000F4 EB0E                            jmp print_sum 
   138                                          ; sum = y[b]
   139                                      
   140                                      ; if a>0
   141                                      normal_sum:
   142 000000F6 8B0C95[A4010000]                mov ecx,[y+edx*4]
   143 000000FD 2B0C85[A0010000]                sub ecx,[y+(eax-1)*4]
   144                                          ; sum = y[b] - y[a-1]
   145                                      
   146                                      ; print the sum in the output file
   147                                      print_sum:
   148 00000104 51                              push ecx
   149 00000105 68[3D030000]                    push fmt_out
   150 0000010A FF35[10000000]                  push dword [fout]
   151 00000110 FF15[00000000]                  call [fprintf]
   152 00000116 83C40C                          add esp,4*3
   153 00000119 EB93                            jmp read_pairs ; continue to read other pairs
   154                                  
   155                                      ; close file and exit
   156                                      end_all:
   157 0000011B FF35[0C000000]                  push dword [fin]
   158 00000121 FF15[00000000]                  call [fclose]
   159 00000127 83C404                          add esp,4*1
   160                                      
   161 0000012A FF35[10000000]                  push dword [fout]
   162 00000130 FF15[00000000]                  call [fclose]
   163 00000136 83C404                          add esp, 4*1
   164                                          
   165 00000139 6A00                            push 0
   166 0000013B FF15[00000000]                  call [exit]
