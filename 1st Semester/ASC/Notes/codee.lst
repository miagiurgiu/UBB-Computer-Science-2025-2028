     1                                  bits 32
     2                                  global start
     3                                  
     4                                  extern exit, fopen, fscanf, fclose, printf, scanf, fprintf
     5                                  import exit msvcrt.dll ; terminate program
     6                                  import fopen msvcrt.dll ; open a file
     7                                  import fscanf msvcrt.dll ; read formatted data from file
     8                                  import fclose msvcrt.dll ; close file
     9                                  import printf msvcrt.dll ; print to console
    10                                  import scanf msvcrt.dll ; read formatted data from keyboard
    11                                  import fprintf msvcrt.dll ; print in file
    12                                  
    13                                  segment data use32 class=data
    14                                      ; defining the file names
    15 00000000 696E7075742E747874-         file_name_input db "input.txt",0 ; inside it we have 10 3 -2 7 -5 4 -8 20 0 but 0 is not part of the array
    15 00000009 00                 
    16 0000000A 00<rep 64h>                 file_name_output times 100 db 0
    17                                      ; file_name_output db 100 dup(0)
    18                                      ; defining the modes - read, write
    19 0000006E 7200                        mode_r db "r",0
    20 00000070 7700                        mode_w db "w", 0
    21                                      
    22                                      ; defining the descriptors - fin, fout
    23 00000072 00000000                    fin dd 0 ; stores the file handle returned by fopen
    24 00000076 00000000                    fout dd 0
    25                                      
    26                                      ; defining the arrays
    27 0000007A 00000000<rep 64h>           x times 100 dd 0 
    28 0000020A 00000000<rep 64h>           y times 100 dd 0 
    29                                      
    30                                      ; defining the formats 
    31 0000039A 256400                      format_int db "%d",0 ; read one integer
    32 0000039D 256420256400                format_pair db "%d %d",0 ; read two integers
    33 000003A3 25640A00                    format_out db "%d",10,0 ; print integer + newline
    34 000003A7 257300                      format_string db "%s", 0
    35                                  
    36                                      ; defining the variables for user-entered pairs:
    37 000003AA 00000000                    a dd 0
    38 000003AE 00000000                    b dd 0
    39                                      
    40                                      ; temporary pointer used to store computed addresses for fscanf
    41 000003B2 00000000                    pointer dd 0 
    42                                  
    43                                  segment code use32 class=code
    44                                      start:
    45                                  
    46                                          ; open input file
    47 00000000 68[6E000000]                    push mode_r
    48 00000005 68[00000000]                    push file_name_input
    49 0000000A FF15[00000000]                  call [fopen]
    50 00000010 83C408                          add esp,4*2
    51 00000013 A3[72000000]                    mov [fin],eax ; store returned file pointer from eax into variable fin
    52                                  
    53                                          ; read numbers from file into x[] until 0
    54 00000018 BE00000000                      mov esi,0  ; esi is the index that goes through x
    55                                          
    56                                          read_nums:
    57                                              ; compute address of x[esi]
    58 0000001D BB[7A000000]                        mov ebx, x ; x is the base address
    59 00000022 89F0                                mov eax, esi
    60 00000024 6BC004                              imul eax, 4 ; each element is 4 bytes
    61 00000027 01C3                                add ebx, eax
    62 00000029 891D[B2030000]                      mov [pointer], ebx
    63                                              
    64                                              ; read one integer from file into x[esi]
    65 0000002F FF35[B2030000]                      push dword [pointer]; address of x[esi]
    66 00000035 68[9A030000]                        push format_int
    67 0000003A FF35[72000000]                      push dword [fin]
    68 00000040 FF15[00000000]                      call [fscanf]
    69 00000046 83C40C                              add esp,4*3
    70                                              
    71                                              ; check if the number is 0 -> stop, end of list
    72 00000049 8B04B5[7A000000]                    mov eax,[x+esi*4] ; the address of x[esi]
    73 00000050 83F800                              cmp eax,0
    74 00000053 7403                                je make_prefix
    75 00000055 46                                  inc esi
    76 00000056 EBC5                                jmp read_nums
    77                                  
    78                                          ; build prefix sums in y[]
    79                                          make_prefix:
    80 00000058 B900000000                          mov ecx,0
    81 0000005D A1[7A000000]                        mov eax,[x]
    82 00000062 A3[0A020000]                        mov [y],eax ; y[0]=x[0]
    83                                      
    84                                          prefix_loop:
    85 00000067 41                                  inc ecx
    86 00000068 39F1                                cmp ecx,esi
    87 0000006A 7D17                                jge done_prefix ; stop when we encounter the last index
    88                                              
    89                                              ; compute y[ecx] = y[ecx-1] + x[ecx]
    90 0000006C 8B048D[06020000]                    mov eax,[y+(ecx-1)*4]
    91 00000073 03048D[7A000000]                    add eax,[x+ecx*4]
    92 0000007A 89048D[0A020000]                    mov [y+ecx*4],eax
    93 00000081 EBE4                                jmp prefix_loop
    94                                              ; now we have y = 10 13 11 18 13 17 9 29
    95                                  
    96                                          done_prefix:
    97                                          ; read output filename
    98 00000083 68[0A000000]                        push file_name_output
    99 00000088 68[A7030000]                        push format_string
   100 0000008D FF15[00000000]                      call [scanf]
   101 00000093 83C408                              add esp, 8
   102                                          
   103                                          ;open output file
   104 00000096 68[70000000]                        push mode_w
   105 0000009B 68[0A000000]                        push file_name_output
   106 000000A0 FF15[00000000]                      call [fopen]
   107 000000A6 83C408                              add esp, 8
   108 000000A9 A3[76000000]                        mov [fout], eax
   109                                          
   110                                          ; read pairs from keyboard
   111                                          read_pairs:
   112 000000AE 68[AE030000]                        push b
   113 000000B3 68[AA030000]                        push a
   114 000000B8 68[9D030000]                        push format_pair
   115 000000BD FF15[00000000]                      call [scanf]
   116 000000C3 83C40C                              add esp,4*3
   117                                                  
   118                                              ; check if we need to exit 
   119 000000C6 A1[AA030000]                        mov eax,[a]
   120 000000CB 8B15[AE030000]                      mov edx,[b]
   121                                  
   122 000000D1 83F8FF                              cmp eax,-1
   123 000000D4 7505                                jne check_int
   124 000000D6 83FAFF                              cmp edx,-1
   125 000000D9 7440                                je end_all
   126                                  
   127                                          check_int:
   128                                              ; validate interval 
   129 000000DB 83F800                              cmp eax,0
   130 000000DE 7CCE                                jl read_pairs ; a<0 => invalid => next pair
   131 000000E0 39C2                                cmp edx,eax
   132 000000E2 7CCA                                jl read_pairs ; b<a => invalid => next pair
   133 000000E4 39F2                                cmp edx,esi
   134 000000E6 7DC6                                jge read_pairs ; b>=the nr of elements => invalid => next pair
   135                                          
   136                                              ; compute sum using prefix sums
   137                                              ; if a=0
   138 000000E8 83F800                              cmp eax,0 
   139 000000EB 7509                                jne normal_sum
   140 000000ED 8B0C95[0A020000]                    mov ecx,[y+edx*4]
   141 000000F4 EB0E                                jmp print_sum 
   142                                              ; sum = y[b]
   143                                      
   144                                          ; if a>0
   145                                          normal_sum:
   146 000000F6 8B0C95[0A020000]                    mov ecx,[y+edx*4]
   147 000000FD 2B0C85[06020000]                    sub ecx,[y+(eax-1)*4]
   148                                              ; sum = y[b] - y[a-1]
   149                                      
   150                                          ; print the sum in the output file
   151                                          print_sum:
   152 00000104 51                                  push ecx
   153 00000105 68[A3030000]                        push format_out
   154 0000010A FF35[76000000]                      push dword [fout]
   155 00000110 FF15[00000000]                      call [fprintf]
   156 00000116 83C40C                              add esp,4*3
   157 00000119 EB93                                jmp read_pairs ; continue to read other pairs
   158                                  
   159                                          ; close file and exit
   160                                          end_all:
   161 0000011B FF35[72000000]                      push dword [fin]
   162 00000121 FF15[00000000]                      call [fclose]
   163 00000127 83C404                              add esp,4*1
   164                                          
   165 0000012A FF35[76000000]                      push dword [fout]
   166 00000130 FF15[00000000]                      call [fclose]
   167 00000136 83C404                              add esp, 4*1
   168                                              
   169 00000139 6A00                                push 0
   170 0000013B FF15[00000000]                      call [exit]
